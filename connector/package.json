{
  "name": "yzvibe",
  "version": "0.1.5",
  "description": "柚子Vibe 桌面连接器：通过手机连接 Claude Code、Codex 和 OMP，管理会话、文件与远程审批",
  "type": "module",
  "bin": {
    "yzvibe": "bin/yzvibe.js"
  },
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/yzvibe.js start",
    "run": "node bin/yzvibe.js run",
    "stop": "node bin/yzvibe.js stop",
    "status": "node bin/yzvibe.js status",
    "dev": "node bin/yzvibe.js run --access=local --agent=mock",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.0",
    "yaml": "^2.9.1"
  },
  "license": "MIT",
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "agent",
    "remote",
    "mobile",
    "cli",
    "websocket",
    "apns"
  ],
  "homepage": "https://github.com/yzstory/yzvibe-app#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yzstory/yzvibe-app.git",
    "directory": "connector"
  },
  "bugs": {
    "url": "https://github.com/yzstory/yzvibe-app/issues"
  },
  "author": "yzstory",
  "files": [
    "bin/",
    "src/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
